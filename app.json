{
  "expo": {
    "name": "TaskApp",
    "slug": "taskapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brunocastillo.taskapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.brunocastillo.taskapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "TaskApp usa tus fotos para adjuntar una imagen a cada tarea.",
          "cameraPermission": "TaskApp usa la cámara para sacar una foto de la tarea.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TaskApp usa tu ubicación para guardar dónde hay que hacer la tarea.",
          "isAndroidForegroundServiceEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "TaskApp usa tus contactos para elegir al responsable de la tarea."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "TaskApp usa tu calendario para agendar las tareas."
        }
      ]
    ]
  }
}
